# Copy to .env.local and adjust if your backend isn't on localhost:8000.
# On Vercel, set NEXT_PUBLIC_API_BASE_URL to your Render backend URL,
# e.g. https://resume-match-advisor-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: link shown by the beta feedback button (e.g. a Google Form).
# NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/your-form-id
